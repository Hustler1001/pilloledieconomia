        eye.add(mk(new THREE.TorusGeometry(0.235, 0.022, 8, 30, Math.PI), C(44, 48, 68), { rot: [0, 0, 0], scale: [1, 1.1, 1], pos: [0, 0.01, 0.06], outline: false }));
