    lens.add(mk(new THREE.PlaneGeometry(0.05, 0.2), null, { outline: false, material: new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.55 }), pos: [-0.12, 0.1, 0.01], rot: [0, 0, 0.7] }));
