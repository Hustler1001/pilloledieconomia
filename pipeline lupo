    else if (cfg.expr === "serious") { tilt = s * 0.2; by = 0.52; }
    g.add(mk(new THREE.CapsuleGeometry(0.03, 0.26, 4, 10), C(72, 50, 40), { pos: [x, by, 0.8], rot: [0, s * 0.3, Math.PI / 2 + tilt * (s === -1 ? 1 : 1) * 0 + tilt], outline: false }));
  });
  g.add(mk(new THREE.CylinderGeometry(0.014, 0.014, 0.18, 6), dk, { pos: [0, EY + 0.02, 0.9], rot: [0, 0, Math.PI / 2], outline: false }));
  // bocca
  const lip = C(206, 62, 88);
