function mat(c, o = {}) { return new THREE.MeshStandardMaterial({ color: c, roughness: o.rough ?? 0.62, metalness: 0, transparent: o.alpha != null, opacity: o.alpha ?? 1, side: o.side ?? THREE.FrontSide }); }
function mk(geom, color, o = {}) {
  const m = new THREE.Mesh(geom, o.material || mat(color, o));
  if (o.pos) m.position.set(...o.pos);
  if (o.scale) m.scale.set(...o.scale);
  if (o.rot) m.rotation.set(...o.rot);
  if (o.outline !== false && !o.material) {
