  else g.add(mk(new THREE.TorusGeometry(0.2, 0.03, 8, 24, Math.PI * 0.8), lip, { pos: [0, -0.34, 0.83], rot: [0, 0, Math.PI * 1.1], outline: false }));
  g.rotation.set(0.02, -0.3, 0);
  return g;
}

window.init = (w, h, fov, camY, camZ, tgtY) => {
  renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
