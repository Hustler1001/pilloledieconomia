    else {
      const sy = cfg.expr === "surprised" ? 1.3 : 1.1;
      eye.add(mk(sph(0.14), C(255, 255, 255), { scale: [1.05, sy, 0.5], outline: false }));
      eye.add(mk(sph(0.085), C(96, 62, 36), { pos: [0, -0.01, 0.05], scale: [1, 1, 0.5], outline: false }));
      eye.add(mk(sph(0.045), C(20, 18, 26), { pos: [0, -0.01, 0.075], scale: [1, 1, 0.5], outline: false }));
      eye.add(mk(sph(0.028), C(255, 255, 255), { pos: [-0.03, 0.03, 0.095], outline: false }));
      eye.add(mk(new THREE.TorusGeometry(0.15, 0.02, 8, 20, Math.PI), dk, { scale: [1.05, 1.1, 1], pos: [0, 0.01, 0.04], outline: false }));
      for (const [dx, dy, a] of [[0.15 * s, 0.1, 0.5 * s], [0.16 * s, 0.03, 0.2 * s]]) eye.add(mk(new THREE.CapsuleGeometry(0.01, 0.09, 4, 6), dk, { pos: [dx, dy + 0.02, 0.04], rot: [0, 0, -a - Math.PI / 2 * 0 + s * 1.2], outline: false }));
